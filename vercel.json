{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-card-db.mjs --soft && node scripts/fetch-cr.mjs --soft && node scripts/build-cube-review.mjs --soft && npm run build",
  "functions": {
    "api/judge.ts": {
      "maxDuration": 300,
      "includeFiles": "data/cr.json"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 9 * * *"
    }
  ]
}
